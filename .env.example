# AgriFlow - Environment Configuration Template
# Copy this file to .env and configure your secrets

# Backend Server Port
PORT=5000

# 1. Google Gemini Multimodal Vision API Key
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
# Used server-side for multimodal crop/food image identification & botanical reasoning
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Google Cloud Vision API Key
# Obtain an API key or service account from Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# Enables Label Detection, Object Localization, Image Properties, and Web Entity Detection
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key_here

# 3. Mandi / Agmarknet API Key (Government of India Open Data)
# Obtain an API key from Open Government Data (OGD) Platform India (https://data.gov.in/)
# Resource: Current Daily Price of Various Commodities (Agmarknet Mandi Wholesale Rates)
MANDI_API_KEY=your_mandi_api_key_here

# 4. Finnworlds / Finnhub Commodity Prices API Key
# Obtain an API key from Finnworlds (https://finnworlds.com/) or Finnhub (https://finnhub.io/)
# Provides real-time global & national commodity quotes (Coffee, Tea, Spices, Grains, Oils)
FINNWORLDS_API_KEY=your_finnworlds_api_key_here

# 5. Sarvam AI Indic Voice Assistant API Key
# Obtain an API key from Sarvam AI Dashboard (https://dashboard.sarvam.ai/)
# Enables Saaras Multilingual Speech-to-Text (STT) and Bulbul Neural Text-to-Speech (TTS)
# Supported Languages: Hindi (hi-IN), Kannada (kn-IN), Tamil (ta-IN), Telugu (te-IN), Marathi (mr-IN), Bengali (bn-IN), etc.
SARVAM_API_KEY=your_sarvam_api_key_here
VITE_SARVAM_API_KEY=your_sarvam_api_key_here

