# ===================================================================
# AgriFlow & FoodPack AI - Backend Environment Configuration Template
# Copy this file to .env and configure your keys.
# DO NOT commit your actual .env file with secrets to Git.
# ===================================================================

# 1. Backend Server Port
PORT=5000

# 2. Google AI Studio / Gemini Vision API Key (Primary AI Image Recognition)
# Get your free API key at: https://aistudio.google.com/
# Used server-side for multimodal identification of vegetables, fruits, dairy, dry fruits, grains, pulses
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Government of India Open Data Platform API Key (Current Commodity Prices)
# Get your API key at: https://data.gov.in/
# Resource: Current Daily Price of Various Commodities (Agmarknet Mandi Wholesale Rates)
DATA_GOV_API_KEY=your_data_gov_in_api_key_here
MANDI_API_KEY=your_data_gov_in_api_key_here

# 4. Weather Services (GPS Location-Based Microclimate & Post-Harvest Weather Alerts)
# PRIMARY: Open-Meteo (https://open-meteo.com) - Automatically active, NO API KEY NEEDED.
# FALLBACK 1: WeatherAPI (https://www.weatherapi.com/) - Optional backup
WEATHERAPI_KEY=your_weatherapi_key_here
# FALLBACK 2: OpenWeatherMap (https://openweathermap.org/) - Optional secondary backup
OPENWEATHER_API_KEY=your_openweather_api_key_here

# 5. Sarvam AI Indic Voice Assistant API Key
# Get your API key at: https://dashboard.sarvam.ai/
# Powers Indic Speech-to-Text (Saaras) & Neural Text-to-Speech (Bulbul) in Kannada, Hindi, Telugu, Tamil, Marathi, English
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional: Google Cloud Vision API Key (Deep OCR & Label Detection)
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key_here

# Optional: Global Commodity Quotes (Coffee, Tea, Spices)
FINNWORLDS_API_KEY=your_finnworlds_api_key_here
